# Cloudflare (Workers Static Assets) — cabeçalhos HTTP
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # CSP em modo de observação até a 1ª semana em produção sem avisos (então trocar por Content-Security-Policy).
  # Recurso novo de outro domínio (API, imagem, fonte) precisa entrar aqui. Troque *.supabase.co pelo projeto real.
  # Violações vão para /api/csp e aparecem no log do Worker (npx wrangler tail finanway).
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://lh3.googleusercontent.com; connect-src 'self' https://cloudflareinsights.com https://accounts.google.com/gsi/ https://*.supabase.co wss://*.supabase.co https://viacep.com.br https://brasilapi.com.br https://api.bcb.gov.br; frame-src 'self' blob: https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
