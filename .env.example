# Copie para .env e preencha com os dados do projeto Supabase do FinFlow (Settings > API).
# Em produção as mesmas variáveis vão no GitHub Actions (publicar.yml) — a URL e a chave anon são públicas.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Cliente OAuth do Google (o mesmo configurado no provedor Google do Supabase); obrigatório para o botão "Entrar com Google"
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Opcional: caminho base, só se o site não for servido na raiz do domínio
# VITE_BASE=/
