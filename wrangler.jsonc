// Cloudflare Workers: serve o site estático (dist/) e recebe os relatórios da CSP. Não há API própria: o navegador fala
// direto com o Supabase, e toda a segurança fica no banco (SEGURANCA.md).
// Publicação: GitHub Actions (.github/workflows/publicar.yml) a cada push na main — `wrangler deploy --name finanway`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finanway",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  // domínio próprio: só depois que a zona finanway.com.br estiver na MESMA conta do Cloudflare (Websites › Add a domain,
  // DNS do Registro.br apontando para o Cloudflare) e o token de API tiver Zone Read + DNS Edit + Workers Routes Edit;
  // sem isso o deploy falha com "Can't infer zone from route". Então descomentar (o deploy cria o DNS e o certificado;
  // www redireciona para o domínio principal em worker/index.ts):
  //   "routes": [{ "pattern": "finanway.com.br", "custom_domain": true }, { "pattern": "www.finanway.com.br", "custom_domain": true }],
  "workers_dev": true
}
